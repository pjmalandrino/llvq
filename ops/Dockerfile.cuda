# CUDA build of the quantization binaries, for HF Jobs GPU flavors.
#
# Separate from `ops/Dockerfile` rather than parameterized by build args,
# because a Space builds its Dockerfile **as written** — `--build-arg` is a
# local-docker concept and does not reach the Hub builder.
#
# ## The compute capability has to be pinned
#
# `candle`'s CUDA build detects the target architecture by running
# `nvidia-smi`. The Space builder has **no GPU**, so detection fails and the
# build dies unless `CUDA_COMPUTE_CAP` is set. That makes the image
# architecture-specific, so the flavor is chosen here and not at launch:
#
#   89 → Ada        : `l4x1` (24 GB), `l40sx1` (48 GB)
#   90 → Hopper     : `h200`
#   80 → Ampere     : `a100-large`
#
# 89 covers the two cheapest GPU flavors, which is what the 0.6B validation and
# the 8B run need. Change it here, and rebuild, to move to H200 for a 32B.

FROM nvidia/cuda:12.4.1-devel-ubuntu22.04 AS build
ARG FEATURES=cuda,fast-linalg
ENV CUDA_COMPUTE_CAP=89
ENV DEBIAN_FRONTEND=noninteractive
RUN apt-get update && apt-get install -y --no-install-recommends \
      curl ca-certificates build-essential pkg-config libssl-dev \
 && rm -rf /var/lib/apt/lists/*
RUN curl --proto '=https' --tlsv1.2 -sSf https://sh.rustup.rs | sh -s -- -y --profile minimal
ENV PATH=/root/.cargo/bin:$PATH
WORKDIR /src
COPY . .
# The workspace release profile is `lto = "thin"` with `codegen-units = 1`,
# which is right for a laptop and too greedy for the Hub's Space builder: the
# first attempt died mid-`llvq-llm` with no `error:` line at all — the
# signature of a SIGKILL, not a compile failure. Linking six candle+CUDA
# binaries under full LTO in one codegen unit is the peak.
#
# Raising the codegen units and capping parallel rustc processes brings the
# peak down. Thin LTO is kept: this image exists to make paid hardware go
# fast, so trading the optimizer away to save a few build minutes would be the
# wrong side of that deal.
ENV CARGO_PROFILE_RELEASE_CODEGEN_UNITS=16
ENV CARGO_BUILD_JOBS=2
# `fast-linalg` is not optional in practice: without it the GPTQ factorization
# runs the reference Cholesky, measured at 28.4 s against 0.7 s with `faer` on
# one block of Qwen3-0.6B — 40× slower, for a bit-identical perplexity. On
# rented hardware that is a 40× bill on that phase.
# `--locked` : sans lui cargo re-résout les dépendances au build, donc l'image
# n'est pas construite depuis l'arbre commité et un chiffre qu'elle produit
# n'est rattachable à aucun commit. Pour un noyau chronométré, c'est la
# différence entre une mesure et une anecdote.
RUN cargo build --release --locked -p llvq-llm --features ${FEATURES} \
      --bin smoke --bin ppl --bin oracle --bin mmlu --bin gbench --bin fusedrun
# 🕳️ `seal` se construit SANS `cuda`, et ça se paie sinon.
#
# Bâti avec la feature comme les autres, il se lie à `libcuda.so.1` — que seule
# une flavor GPU fournit. Or `seal.rs` code `Device::Cpu` en dur : il ne fait
# que relire un artefact, recopier les tenseurs que le quantifieur n'a pas
# touchés et convertir en f16. La feature était du bagage, et elle a coûté un
# job mort en une minute le 2026-08-09 sur `cpu-upgrade` (0,001 $, la bonne
# façon d'apprendre : la flavor la moins chère d'abord).
#
# Sans elle, le scellement tourne à 0,03 $/h au lieu de 0,80 sur la plus petite
# carte — un facteur 27 sur une étape qui n'a rien à calculer.
RUN cargo build --release --locked -p llvq-llm --bin seal
# The CUDA kernel bench. A separate `cargo build` on purpose: `llvq-cuda`
# links neither candle nor `faer`, so it costs one small LTO link rather than
# joining the one that has already been SIGKILLed once. Its kernels are not
# compiled here at all — they ship as text and NVRTC compiles them at startup,
# so tuning a tile size or a register cap never touches this image again.
RUN cargo build --release --locked -p llvq-cuda --bin preflight --bin matvec --bin rotbench --bin graphbench --bin planesbench

FROM nvidia/cuda:12.4.1-runtime-ubuntu22.04
ENV DEBIAN_FRONTEND=noninteractive
RUN apt-get update && apt-get install -y --no-install-recommends \
      ca-certificates libssl3 \
 && rm -rf /var/lib/apt/lists/*
# The binaries the GPU path needs: `oracle` proves the forward pass on this
# backend, `smoke` quantizes, `ppl` scores perplexity, `mmlu` scores
# capability. `run` stays out — one more LTO link at build time, which is
# exactly what killed the first attempt, and it is not on the measurement path.
#
# 🕳️ **`seal` came back in on 2026-08-09, and its absence was a hard blocker,
# not a saving.** `smoke` writes a projections-only artifact; `ppl`, `mmlu`
# and `fusedrun` all require the **sealed** file. So a quantization run of a
# model too large to seal on the dev machine produced bytes nobody could
# score. That is now every model that matters: a Qwen3-14B checkpoint is
# 29.5 GB in bf16 against 22 GiB free on the Mac, and a 32B is 65.5 GB. The
# rule the operator set on the same day — everything on the Hub, nothing
# local — makes in-container sealing the only path, so the LTO risk this
# comment was protecting against has to be paid rather than avoided. If the
# builder SIGKILLs again, lower `CARGO_BUILD_JOBS` before dropping a binary.
#
# `mmlu` was added on 2026-08-04: the measurement campaign compares three arms
# on MMLU, and the axis carries the best-founded argument in the dossier (the
# baseline reproduces the paper to 0.17 σ). Without this line it is simply not
# executable on the target.
COPY --from=build \
      /src/target/release/smoke \
      /src/target/release/ppl \
      /src/target/release/oracle \
      /src/target/release/mmlu \
      /src/target/release/gbench \
      /src/target/release/fusedrun \
      /src/target/release/seal \
      /src/target/release/preflight \
      /src/target/release/matvec \
      /src/target/release/rotbench \
      /src/target/release/graphbench \
      /src/target/release/planesbench \
      /usr/local/bin/
ENV HF_HOME=/scratch/hf
WORKDIR /scratch
# Space runtime only — a Job always overrides the command.
CMD ["sleep", "infinity"]
