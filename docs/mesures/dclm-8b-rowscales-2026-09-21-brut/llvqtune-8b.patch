 BUDGET=${BUDGET:-7200}          # seconds of training, loading excluded
 SEQ=${SEQ:-1024}
 BATCH=${BATCH:-2}
 LR=${LR:-3e-4}
 PROBE=${PROBE:-6}
+STEPS_SET=${STEPS:-}
 
