--- a/ops/llvqtune/train.sh	2026-09-19 18:40:26
+++ b/ops/llvqtune/train.sh	2026-09-21 22:12:55
@@ -4,50 +4,142 @@
 # Preregistered: proofs/preregistration-tetranu-rowscales-2026-09-19.md
 # Deviations:    same name, -ECARTS.md
