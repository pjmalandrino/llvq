+[ -z "$STEPS_SET" ] || positive_int STEPS "$STEPS_SET"
+[ -z "${MAX_TRAIN_SECONDS:-}" ] || positive_int MAX_TRAIN_SECONDS "$MAX_TRAIN_SECONDS"
