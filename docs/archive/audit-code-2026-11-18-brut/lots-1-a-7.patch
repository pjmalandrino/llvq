+    let (tx, rx) = std::sync::mpsc::channel();
+    let h = host.to_string();
+    let first = std::thread::spawn(move || stream_ended(&h, "the cat sat on the mat", 400, Some(tx)));
+    rx.recv_timeout(std::time::Duration::from_secs(60)).expect("the long request never sent a chunk");
+    let second = stream_ended(host, "why", 20, None);
+    [("the request that joined the pool", first.join().unwrap()), ("the second request", second)]
