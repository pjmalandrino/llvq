+def _require_current_cuda(values) -> None:
+    """The model goes to `"cuda"`, the current card, so a `device_map` that names another is refused.
+
+    `finalize` and the fused buffers address the device by its kind only. Without this a map that
+    names card 1 would load on the current one and say nothing.
+    """
+    current = None
+    for value in values:
+        name = str(value)
+        if isinstance(value, int) or name.isdigit():
+            index = int(name)
+        elif name.startswith("cuda:") and name[5:].isdigit():
+            index = int(name[5:])
+        else:
+            continue
+        if current is None:
+            current = torch.cuda.current_device() if torch.cuda.is_available() else 0
+        if index != current:
+            raise ValueError(
+                f"LLVQ models load on the current CUDA device, cuda:{current}, and the device_map "
+                f"names {value!r}. Select that card with torch.cuda.set_device or "
+                "CUDA_VISIBLE_DEVICES and pass device_map=\"cuda\""
+            )
