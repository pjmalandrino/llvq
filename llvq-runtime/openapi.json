          "include_usage": {
            "type": [
              "boolean",
              "null"
            ]
          }
        },
        "type": "object"
      },
      "Usage": {
        "properties": {
          "completion_tokens": {
            "minimum": 0,
            "type": "integer"
          },
          "prompt_tokens": {
            "minimum": 0,
            "type": "integer"
          },
          "total_tokens": {
            "minimum": 0,
            "type": "integer"
          }
        },
        "required": [
          "prompt_tokens",
          "completion_tokens",
          "total_tokens"
        ],
        "type": "object"
      },
      "VersionResponse": {
        "properties": {
          "commit": {
            "description": "The commit the binary was built from.",
            "type": "string"
          },
          "version": {
            "type": "string"
          }
        },
        "required": [
          "version",
          "commit"
        ],
        "type": "object"
      }
    }
  },
